# ==============================================================================
# KeySmasher Environment Configuration Template
# Copy this file to .env.local for Next.js web application
# DO NOT COMMIT SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL
# ==============================================================================

# Web Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Authentication - Phase F)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Real-time Multiplayer Socket.IO Server (Phase I & J)
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4000
REALTIME_PORT=4000
CORS_ORIGIN=http://localhost:3000
